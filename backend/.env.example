APP_ENV=development

# AI: mock | gemini | groq
AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=groq

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=30

# comma-separated; add the Vercel URL when deployed
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_ROWS_PER_TABLE=100000
# rows x columns: per generation, and for all kept datasets together
MAX_TOTAL_CELLS=8000000
MAX_STORE_CELLS=30000000
MAX_CONCURRENT_GENERATIONS=2
MAX_DATASETS=20
DATASET_TTL_MINUTES=60

# true only for local dev; false on Railway
ALLOW_PRIVATE_DB_HOSTS=true
DEFAULT_SAMPLE_LIMIT=200
MAX_SAMPLE_LIMIT=1000
